# Copia este archivo como .env y rellena los valores reales.

# Supabase — credenciales del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alias que consume el código de este proyecto (supabase.js)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=

# Puerto del servidor Express
PORT=3000

# Acceso — firma de los tokens de sesión.
# Cualquier cadena larga y secreta. Si se deja vacía se deriva de la clave de
# Supabase; definirla evita que las sesiones se invaliden al rotar esa clave.
AUTH_SECRET=

# Clave temporal del administrador que se crea solo si la tabla usuarios está
# vacía (por defecto: admin123). El sistema obliga a cambiarla al ingresar.
ADMIN_CLAVE_INICIAL=
